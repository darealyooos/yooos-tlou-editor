<Window x:Class="FactionsReborn.WorldEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FactionsReborn.WorldEditor"
        Title="Yooos TLOU Editor" Width="1680" Height="1000" MinWidth="1180" MinHeight="720"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Text}" FontFamily="{StaticResource Body}" FontSize="12"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- Thumbnail or category placeholder, shared by list rows and grid tiles. -->
    <DataTemplate x:Key="ThumbTemplate" DataType="{x:Type local:BrowserItem}">
      <Grid>
        <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line}" BorderThickness="1">
          <TextBlock Text="{Binding Initial}" FontFamily="{StaticResource Display}" FontWeight="Light" FontSize="13" Foreground="{StaticResource Text4}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Border Background="{StaticResource Bg2}" Visibility="{Binding NoMesh, Converter={StaticResource BoolVis}}" ToolTip="This pak has no mesh (skeleton, animation, collision or data only)">
          <TextBlock Text="no mesh" FontFamily="{StaticResource Display}" FontSize="9.5" Foreground="{StaticResource Text4}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </DataTemplate>

    <!-- List row. -->
    <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:BrowserItem}">
      <Grid DataContextChanged="OnBrowserItemShown" Loaded="OnBrowserItemLoaded" Height="{DynamicResource RowHeight}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ThumbTemplate}" Width="{DynamicResource RowHeight}" Height="{DynamicResource RowHeight}"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
          <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="&#xE735;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource Amber}"
                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}"/>
      </Grid>
    </DataTemplate>

    <!-- Grid tile (rows of tiles keep the list virtualised). -->
    <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:BrowserItem}">
      <Border x:Name="tile" Margin="0,0,6,6" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="1" Cursor="Hand"
              DataContextChanged="OnBrowserItemShown" Loaded="OnBrowserItemLoaded" MouseLeftButtonDown="OnTileMouseDown" MouseMove="OnTileMouseMove" ToolTip="{Binding Label}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="{DynamicResource TileImageHeight}"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ThumbTemplate}"/>
          <TextBlock Text="&#xE735;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource Amber}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0"
                     Visibility="{Binding IsFavorite, Converter={StaticResource BoolVis}}"/>
          <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="11" Margin="6,5,6,6" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text2}"/>
          <Rectangle x:Name="mark" Grid.RowSpan="2" Height="2" VerticalAlignment="Bottom" Fill="{StaticResource Amber}" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="tile" Property="IsMouseOver" Value="True">
          <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Line3}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource Amber}"/>
          <Setter TargetName="tile" Property="Background" Value="{StaticResource AmberWash}"/>
          <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="ShortcutRow" TargetType="Grid">
      <Setter Property="Margin" Value="0,3"/>
    </Style>
  </Window.Resources>

  <DockPanel x:Name="RootDock" LastChildFill="True">

    <!-- ================================================================ navigation -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid Height="40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Brand -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,18,0">
          <Grid Width="18" Height="18" Margin="0,0,10,0">
            <Rectangle Stroke="{StaticResource Amber}" StrokeThickness="1"/>
            <Rectangle Fill="{StaticResource Amber}" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"/>
          </Grid>
          <TextBlock Text="YOOOS" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
          <TextBlock Text="TLOU EDITOR" FontFamily="{StaticResource Display}" FontWeight="Light" FontSize="13" Foreground="{StaticResource Text2}" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Menus and workspaces -->
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Rectangle Width="1" Fill="{StaticResource Line}" Margin="0,11"/>
          <Button x:Name="SceneMenuButton" Style="{StaticResource NavMenu}" Content="Scene" Click="OnOpenNavMenu" Margin="4,0,0,0">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="MenuNew" Header="New scene" Click="OnNewScene"/>
                <MenuItem x:Name="MenuOpen" Header="Open scene…" Click="OnOpenScene"/>
                <MenuItem x:Name="MenuOpenRecovery" Header="Open autosave folder" Click="OnOpenAutosaveFolder"/>
                <Separator/>
                <MenuItem x:Name="MenuSave" Header="Save scene" Click="OnSaveScene"/>
                <MenuItem x:Name="MenuSaveAs" Header="Save scene as…" Click="OnSaveSceneAs"/>
                <Separator/>
                <MenuItem Header="Save viewport image…" Click="OnSaveImage"/>
                <Separator/>
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="OnExit"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Rectangle Width="1" Fill="{StaticResource Line}" Margin="4,11"/>
          <RadioButton x:Name="NavCatalogue" Style="{StaticResource NavTab}" GroupName="Workspace" Content="Asset Catalogue" Checked="OnWorkspaceTab"/>
          <RadioButton x:Name="NavWorld" Style="{StaticResource NavTab}" GroupName="Workspace" Content="World Editor" IsChecked="True" Checked="OnWorkspaceTab"/>
          <Button x:Name="ViewportMenuButton" Style="{StaticResource NavMenu}" Content="Viewport" Click="OnOpenNavMenu">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="LAYERS" Style="{StaticResource MenuHeading}"/>
                <MenuItem x:Name="ShowMap" Header="Map geometry" IsCheckable="True" IsChecked="True" Click="OnToggleLayers"/>
                <MenuItem x:Name="ShowVegetation" Header="Map vegetation" IsCheckable="True" IsChecked="True" Click="OnToggleLayers"/>
                <MenuItem x:Name="ShowGrid" Header="Ground grid" IsCheckable="True" IsChecked="True" Click="OnToggleLayers"/>
                <Separator/>
                <MenuItem Header="CAMERA" Style="{StaticResource MenuHeading}"/>
                <MenuItem x:Name="MenuFocus" Header="Focus selection" Click="OnFocus"/>
                <MenuItem x:Name="MenuFrameAll" Header="Frame everything" Click="OnFrameAll"/>
                <MenuItem x:Name="MenuResetCamera" Header="Reset camera" Click="OnResetCamera"/>
                <Separator/>
                <MenuItem Header="PANELS" Style="{StaticResource MenuHeading}"/>
                <MenuItem x:Name="MenuToggleBrowser" Header="Asset Browser" IsCheckable="True" IsChecked="True" Click="OnPanelMenu"/>
                <MenuItem x:Name="MenuToggleHierarchy" Header="Scene Hierarchy" IsCheckable="True" IsChecked="True" Click="OnPanelMenu"/>
                <MenuItem x:Name="MenuToggleInspector" Header="Inspector" IsCheckable="True" IsChecked="True" Click="OnPanelMenu"/>
                <MenuItem x:Name="MaximiseItem" Header="Maximise viewport" IsCheckable="True" Click="OnToggleMaximise"/>
                <Separator/>
                <MenuItem Header="Save viewport image…" Click="OnSaveImage"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="ToolsMenuButton" Style="{StaticResource NavMenu}" Content="Tools" Click="OnOpenNavMenu">
            <Button.ContextMenu>
              <ContextMenu x:Name="ToolsMenu" Opened="OnToolsMenuOpened">
                <MenuItem Header="EDIT" Style="{StaticResource MenuHeading}"/>
                <MenuItem x:Name="MenuUndo" Header="Undo" Click="OnUndo" IsEnabled="False"/>
                <MenuItem x:Name="MenuRedo" Header="Redo" Click="OnRedo" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="TRANSFORM" Style="{StaticResource MenuHeading}"/>
                <MenuItem x:Name="MenuSelect" Header="Select" Click="OnToolSelect"/>
                <MenuItem x:Name="MenuMove" Header="Move" Click="OnToolMove"/>
                <MenuItem x:Name="MenuRotate" Header="Rotate" Click="OnToolRotate"/>
                <MenuItem x:Name="MenuScale" Header="Scale" Click="OnToolScale"/>
                <Separator/>
                <MenuItem Header="ARENA" Style="{StaticResource MenuHeading}"/>
                <MenuItem x:Name="MenuSpawnWlf" Header="Add WLF spawn" Click="OnAddSpawnWlf"/>
                <MenuItem x:Name="MenuSpawnScars" Header="Add Seraphite spawn" Click="OnAddSpawnScars"/>
                <MenuItem x:Name="MenuBoundary" Header="Draw boundary" Click="OnMenuBoundary"/>
                <MenuItem Header="Clear boundary" Click="OnClearBoundary"/>
                <Separator/>
                <MenuItem Header="SELECTION" Style="{StaticResource MenuHeading}"/>
                <MenuItem x:Name="MenuDuplicate" Header="Duplicate" Click="OnDuplicate"/>
                <MenuItem x:Name="MenuDeleteItem" Header="Delete" Click="OnDelete"/>
                <MenuItem Header="Deselect" InputGestureText="Esc" Click="OnDeselect"/>
                <Separator/>
                <MenuItem x:Name="MenuShortcuts" Header="Keyboard shortcut sheet" Click="OnToggleShortcuts"/>
                <MenuItem Header="Customise shortcuts…" Click="OnCustomiseShortcuts"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavTab}" GroupName="Workspace" Content="Settings" Checked="OnWorkspaceTab"/>
        </StackPanel>

        <!-- Current scene -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Ellipse x:Name="DirtyDot" Width="6" Height="6" Fill="{StaticResource Amber}" Margin="0,0,8,0" Visibility="Collapsed" ToolTip="Unsaved changes"/>
          <TextBlock x:Name="SceneNameText" FontFamily="{StaticResource Display}" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================================================ status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Height="26">
      <Grid Margin="14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="SCENE" Style="{StaticResource Micro}" Margin="0,0,6,0"/>
          <TextBlock x:Name="StatusProject" FontSize="11" Foreground="{StaticResource Text2}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <TextBlock Text="SELECTED" Style="{StaticResource Micro}" Margin="0,0,6,0"/>
          <TextBlock x:Name="StatusSelection" Text="—" FontSize="11" Foreground="{StaticResource Text2}" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,12,0">
          <Ellipse x:Name="LoadDot" Width="6" Height="6" Fill="{StaticResource Olive}" Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="Initialising" FontSize="11" Foreground="{StaticResource Text3}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="MAP" Style="{StaticResource Micro}" Margin="0,0,6,0"/>
          <TextBlock x:Name="StatusTris" Text="—" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Text2}"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="CAMERA" Style="{StaticResource Micro}" Margin="0,0,6,0"/>
          <TextBlock x:Name="StatusCamera" Text="—" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Text2}"/>
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="FPS" Style="{StaticResource Micro}" Margin="0,0,6,0"/>
          <TextBlock x:Name="StatusFps" Text="—" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Text2}" MinWidth="22"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================================================================ workspace -->
    <Grid x:Name="WorkspaceGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="LeftColumn" Width="300" MinWidth="250"/>
        <ColumnDefinition x:Name="LeftSplitColumn" Width="1"/>
        <ColumnDefinition Width="*" MinWidth="400"/>
        <ColumnDefinition x:Name="RightSplitColumn" Width="1"/>
        <ColumnDefinition x:Name="RightColumn" Width="320" MinWidth="260"/>
      </Grid.ColumnDefinitions>

      <!-- ============================================== asset browser -->
      <Border x:Name="BrowserPanel" Grid.Column="0" Background="{StaticResource Bg1}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="14,14,14,0">
            <Grid>
              <TextBlock Text="ASSET BROWSER" Style="{StaticResource MicroAccent}"/>
              <TextBlock x:Name="BrowserCount" HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Text3}"/>
            </Grid>

            <!-- Search -->
            <Grid Margin="0,10,0,0">
              <TextBox x:Name="SearchBox" Padding="26,6,24,6" TextChanged="OnFilterChanged" ToolTip="Filter by name; separate words narrow the results  (Ctrl+F)"/>
              <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" HorizontalAlignment="Left" Margin="9,0,0,0" Foreground="{StaticResource Text3}" IsHitTestVisible="False"/>
              <TextBlock x:Name="SearchHint" Text="Search assets" Margin="27,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Text4}" IsHitTestVisible="False"/>
              <Button x:Name="SearchClear" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Padding="7,4" Margin="0,0,1,0" Click="OnClearSearch" Visibility="Collapsed" ToolTip="Clear search">
                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="9"/>
              </Button>
            </Grid>

            <!-- Source -->
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="1" Margin="0,10,0,0">
              <UniformGrid Columns="3">
                <RadioButton x:Name="KindActors" Style="{StaticResource Segment}" GroupName="Source" Content="Actors" IsChecked="True" Checked="OnSourceChanged" ToolTip="Placeable actor paks (props, characters, weapons…)"/>
                <RadioButton x:Name="KindMapProtos" Style="{StaticResource Segment}" GroupName="Source" Content="Map pieces" Checked="OnSourceChanged" ToolTip="Prototypes of the open map(s): native buildings, walls, props"/>
                <RadioButton x:Name="KindLevels" Style="{StaticResource Segment}" GroupName="Source" Content="Levels" Checked="OnSourceChanged" ToolTip="Level paks you can open as the scene's background"/>
              </UniformGrid>
            </Border>

            <!-- Categories (built from the indexed content) -->
            <WrapPanel x:Name="CategoryPanel" Margin="0,10,0,0" ToolTip="Categories are inferred from asset names"/>

            <!-- Filters, sorting, view -->
            <Grid Margin="0,4,0,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ToggleButton x:Name="FavOnly" Style="{StaticResource IconToggle}" Click="OnFilterChanged" ToolTip="Show favourites only">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="FavOnlyGlyph" Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="11"/>
                  <TextBlock Text="Favourites" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <ComboBox x:Name="SortBox" Grid.Column="1" Margin="8,0" SelectionChanged="OnFilterChanged" ToolTip="Sort order">
                <ComboBoxItem Content="Name A–Z" IsSelected="True"/>
                <ComboBoxItem Content="Name Z–A"/>
                <ComboBoxItem Content="Largest first"/>
                <ComboBoxItem Content="Smallest first"/>
                <ComboBoxItem Content="Archive"/>
              </ComboBox>
              <Border Grid.Column="2" BorderBrush="{StaticResource Line2}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ViewList" Style="{StaticResource Segment}" GroupName="BrowserView" Width="28" Padding="0,5" IsChecked="True" Checked="OnBrowserViewChanged" ToolTip="List view">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource Glyph}" FontSize="11"/>
                  </RadioButton>
                  <RadioButton x:Name="ViewGrid" Style="{StaticResource Segment}" GroupName="BrowserView" Width="28" Padding="0,5" Checked="OnBrowserViewChanged" ToolTip="Grid view">
                    <TextBlock Text="&#xF0E2;" Style="{StaticResource Glyph}" FontSize="11"/>
                  </RadioButton>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <!-- Compact detail card (World Editor workspace) -->
          <Border x:Name="CompactDetail" DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="{StaticResource Bg2}">
            <StackPanel Margin="14,12,14,14">
              <Grid Margin="0,0,0,10">
                <Border x:Name="PreviewHostCompact" Height="132" Background="{StaticResource ViewportSky}" BorderBrush="{StaticResource Line}" BorderThickness="1" ClipToBounds="True" ToolTip="Drag to orbit · wheel to zoom"/>
                <TextBlock x:Name="CompactPreviewStatus" Text="Select an asset to preview it" Style="{StaticResource Dim}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"/>
              </Grid>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailName" Text="No asset selected" Style="{StaticResource Title}" FontSize="15"/>
                <ToggleButton x:Name="FavToggle" Grid.Column="1" Style="{StaticResource IconToggle}" Click="OnToggleFavorite" ToolTip="Favourite" IsEnabled="False">
                  <TextBlock x:Name="FavToggleGlyph" Text="&#xE734;" Style="{StaticResource Glyph}" FontSize="12"/>
                </ToggleButton>
              </Grid>
              <TextBlock x:Name="AssetInfo" Text="Waiting for asset index…" Style="{StaticResource Dim}" Margin="0,3,0,10" MaxHeight="64" TextTrimming="CharacterEllipsis"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="PlaceButton" Style="{StaticResource Primary}" Content="Place in scene" Click="OnPlaceAsset" IsEnabled="False" ToolTip="Places the asset at the point under the viewport centre (or drag it into the viewport)"/>
                <Button x:Name="OpenMapButton" Grid.Column="2" Content="Open map" Click="OnOpenMap" IsEnabled="False" ToolTip="Opens the level as the scene's read-only background"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Results -->
          <Grid Margin="4,0,4,0">
            <ListBox x:Name="AssetList" ItemTemplate="{StaticResource RowTemplate}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="OnAssetSelected" MouseDoubleClick="OnAssetDoubleClick" PreviewMouseMove="OnAssetDragStart"/>
            <ListBox x:Name="AssetGrid" Visibility="Collapsed" Padding="10,0,4,0"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" SizeChanged="OnAssetGridSizeChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Focusable" Value="False"/>
                  <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:BrowserRow}">
                  <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource TileTemplate}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><UniformGrid Rows="1" Columns="{Binding Columns}"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="BrowserEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Visibility="Collapsed" IsHitTestVisible="False">
              <TextBlock x:Name="BrowserEmptyTitle" Text="Nothing here" Style="{StaticResource Title}" FontSize="15" HorizontalAlignment="Center"/>
              <TextBlock x:Name="BrowserEmptyText" Style="{StaticResource Dim}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="220"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
      <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5" Margin="-2,0" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" Panel.ZIndex="5"/>

      <!-- ============================================== centre -->
      <Grid Grid.Column="2">
        <!-- World view -->
        <Grid x:Name="WorldView" SizeChanged="OnWorldViewSizeChanged">
          <Border x:Name="ViewportHost" Background="{StaticResource ViewportSky}" ClipToBounds="True" Focusable="True" AllowDrop="True" FocusVisualStyle="{x:Null}"
                  MouseDown="OnViewportMouseDown" MouseUp="OnViewportMouseUp" MouseMove="OnViewportMouseMove" MouseWheel="OnViewportWheel"
                  Drop="OnViewportDrop" DragOver="OnViewportDragOver" DragLeave="OnViewportDragLeave">
            <Grid>
              <Viewport3D x:Name="Viewport" ClipToBounds="True" IsHitTestVisible="False"/>
              <Rectangle Fill="{StaticResource Vignette}" IsHitTestVisible="False"/>
            </Grid>
          </Border>
          <Border x:Name="DropHighlight" BorderBrush="{StaticResource Amber}" BorderThickness="1" IsHitTestVisible="False" Visibility="Collapsed" Margin="0"/>

          <!-- Transform + arena tools -->
          <Border x:Name="ToolOverlay" Style="{StaticResource Overlay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="ToolSelect" Style="{StaticResource Tool}" Click="OnToolSelect" ToolTip="Select only, no gizmo">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Select"/><TextBlock x:Name="KeySelect" Text="Q" Opacity="0.55" Margin="6,0,0,0"/></StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ToolMove" Style="{StaticResource Tool}" IsChecked="True" Click="OnToolMove" ToolTip="Move along an axis · hold Ctrl to snap 0.25 m">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Move"/><TextBlock x:Name="KeyMove" Text="W" Opacity="0.55" Margin="6,0,0,0"/></StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ToolRotate" Style="{StaticResource Tool}" Click="OnToolRotate" ToolTip="Rotate about an axis · hold Ctrl to snap 15°">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Rotate"/><TextBlock x:Name="KeyRotate" Text="E" Opacity="0.55" Margin="6,0,0,0"/></StackPanel>
              </ToggleButton>
              <ToggleButton x:Name="ToolScale" Style="{StaticResource Tool}" Click="OnToolScale" ToolTip="Scale along an axis · Shift for uniform, Ctrl to snap">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Scale"/><TextBlock x:Name="KeyScale" Text="R" Opacity="0.55" Margin="6,0,0,0"/></StackPanel>
              </ToggleButton>
              <Rectangle Width="1" Fill="{StaticResource Line2}" Margin="2,6"/>
              <ToggleButton x:Name="ToolBoundary" Style="{StaticResource Tool}" Click="OnToolBoundary" ToolTip="Click the ground to add arena boundary points · Esc to finish">
                <StackPanel Orientation="Horizontal"><TextBlock Text="Boundary"/><TextBlock x:Name="KeyBoundary" Text="B" Opacity="0.55" Margin="6,0,0,0"/></StackPanel>
              </ToggleButton>
              <Rectangle Width="1" Fill="{StaticResource Line2}" Margin="2,6"/>
              <Button Style="{StaticResource Ghost}" Click="OnAddSpawnWlf" ToolTip="Add a WLF spawn at the viewport centre">
                <StackPanel Orientation="Horizontal"><Rectangle Width="6" Height="6" Fill="#5C8DB8" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="WLF spawn"/></StackPanel>
              </Button>
              <Button Style="{StaticResource Ghost}" Click="OnAddSpawnScars" ToolTip="Add a Seraphite spawn at the viewport centre">
                <StackPanel Orientation="Horizontal"><Rectangle Width="6" Height="6" Fill="#B5523B" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="Seraphite spawn"/></StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <!-- Layers + framing -->
          <Border x:Name="LayerOverlay" Style="{StaticResource Overlay}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
            <StackPanel Orientation="Horizontal">
              <ToggleButton x:Name="ChipMap" Style="{StaticResource IconToggle}" IsChecked="True" Click="OnLayerChip" Content="Map" Padding="9,5" ToolTip="Show map geometry"/>
              <ToggleButton x:Name="ChipVegetation" Style="{StaticResource IconToggle}" IsChecked="True" Click="OnLayerChip" Content="Vegetation" Padding="9,5" ToolTip="Show map vegetation"/>
              <ToggleButton x:Name="ChipGrid" Style="{StaticResource IconToggle}" IsChecked="True" Click="OnLayerChip" Content="Grid" Padding="9,5" ToolTip="Show ground grid  (G)"/>
              <Rectangle Width="1" Fill="{StaticResource Line2}" Margin="2,6"/>
              <Button Style="{StaticResource Ghost}" Click="OnFrameAll" ToolTip="Frame everything  (Shift+F)" Content="Frame"/>
              <Button Style="{StaticResource Ghost}" Click="OnToggleMaximiseButton" ToolTip="Maximise viewport  (F11)" Padding="8,5">
                <TextBlock x:Name="MaximiseGlyph" Text="&#xE740;" Style="{StaticResource Glyph}" FontSize="11"/>
              </Button>
            </StackPanel>
          </Border>

          <!-- Boundary drawing banner -->
          <Border x:Name="BoundaryBanner" Style="{StaticResource Overlay}" BorderBrush="{StaticResource AmberLo}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,58,0,0" Padding="14,7" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="{StaticResource Amber}" Margin="0,0,9,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="BoundaryBannerText" Text="Drawing boundary — click the ground to add points · Esc to finish" FontSize="11.5" Foreground="{StaticResource Text}"/>
            </StackPanel>
          </Border>

          <!-- Camera hint -->
          <Border Style="{StaticResource Overlay}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10,6" Background="#99111311" BorderThickness="0" IsHitTestVisible="False">
            <TextBlock FontSize="10.5" Foreground="{StaticResource Text3}">
              <Run Text="RMB" Foreground="{StaticResource Text2}"/><Run Text=" look   "/><Run x:Name="HintFly" Text="WASD" Foreground="{StaticResource Text2}"/><Run Text=" fly   "/><Run x:Name="HintUpDown" Text="Q/E" Foreground="{StaticResource Text2}"/><Run Text=" down/up   "/><Run Text="Alt+LMB" Foreground="{StaticResource Text2}"/><Run Text=" orbit   "/><Run Text="MMB" Foreground="{StaticResource Text2}"/><Run Text=" pan   "/><Run Text="Wheel" Foreground="{StaticResource Text2}"/><Run Text=" dolly   "/><Run Text="Shift" Foreground="{StaticResource Text2}"/><Run Text=" faster   "/><Run x:Name="HintShortcuts" Text="F1" Foreground="{StaticResource Text2}"/><Run Text=" shortcuts"/>
            </TextBlock>
          </Border>

          <!-- Empty state -->
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <TextBlock Text="AN EMPTY WORLD" Style="{StaticResource MicroAccent}" HorizontalAlignment="Center"/>
            <TextBlock Text="Open a level to begin" Style="{StaticResource Title}" FontSize="28" HorizontalAlignment="Center" Margin="0,8,0,8"/>
            <TextBlock Text="Pick a level from the browser to load it as a read-only backdrop, then place native buildings, props and spawns on top." Style="{StaticResource Dim}" FontSize="12" TextAlignment="Center" Foreground="{StaticResource Text2}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
              <Button Style="{StaticResource Primary}" Content="Browse levels" Click="OnBrowseLevels" Margin="0,0,8,0" Padding="16,7"/>
              <Button Content="Open scene…" Click="OnOpenScene" Padding="16,7"/>
            </StackPanel>
          </StackPanel>

          <!-- Keyboard shortcut sheet -->
          <Border x:Name="ShortcutSheet" Style="{StaticResource Overlay}" Background="#F2111311" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,20" Visibility="Collapsed" MouseDown="OnShortcutSheetClick">
            <StackPanel>
              <Grid Margin="0,0,0,12">
                <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource MicroAccent}"/>
                <TextBlock Text="F1 / Esc to close" Style="{StaticResource Micro}" HorizontalAlignment="Right"/>
              </Grid>
              <Grid x:Name="ShortcutGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="36"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Settings view -->
        <Grid x:Name="SettingsView" Visibility="Collapsed" Background="{StaticResource Bg0}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,22,0,16">
              <StackPanel DockPanel.Dock="Top" Margin="22,0,22,14">
                <TextBlock Text="PREFERENCES" Style="{StaticResource MicroAccent}"/>
                <TextBlock Text="Settings" Style="{StaticResource Title}" FontSize="26" Margin="0,6,0,0"/>
              </StackPanel>
              <TextBlock DockPanel.Dock="Bottom" x:Name="SettingsFileText" Style="{StaticResource Dim}" FontSize="10.5" Margin="22,0" TextWrapping="Wrap"/>
              <ListBox x:Name="SettingsSections" SelectionChanged="OnSettingsSectionChanged" Margin="8,0">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="14,9"/>
                    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
                    <Setter Property="FontSize" Value="13"/>
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </DockPanel>
          </Border>
          <ScrollViewer x:Name="SettingsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsContent" MaxWidth="780" HorizontalAlignment="Left" Margin="40,26,40,40"/>
          </ScrollViewer>
        </Grid>

        <!-- Catalogue view -->
        <Grid x:Name="CatalogueView" Visibility="Collapsed" Background="{StaticResource Bg0}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
          <Grid>
            <Border x:Name="PreviewHostLarge" Background="{StaticResource ViewportSky}" ClipToBounds="True"/>
            <Rectangle Fill="{StaticResource Vignette}" IsHitTestVisible="False"/>
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,24" IsHitTestVisible="False">
              <TextBlock x:Name="CatKind" Text="ASSET CATALOGUE" Style="{StaticResource MicroAccent}"/>
              <TextBlock x:Name="CatTitle" Text="Select an asset" Style="{StaticResource Title}" FontSize="32" Margin="0,6,0,0" MaxWidth="720"/>
              <TextBlock x:Name="CatSubtitle" Style="{StaticResource Dim}" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,4,0,0" MaxWidth="720"/>
            </StackPanel>
            <TextBlock x:Name="PreviewHint" Text="Drag to orbit · wheel to zoom" Style="{StaticResource Micro}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" IsHitTestVisible="False"/>
            <TextBlock x:Name="PreviewStatus" Style="{StaticResource Dim}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextAlignment="Center" MaxWidth="380"/>
          </Grid>
          <Border Grid.Column="1" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <DockPanel Margin="20,22,20,20">
              <StackPanel DockPanel.Dock="Bottom">
                <Button x:Name="CatPlaceButton" Style="{StaticResource Primary}" Content="Place in World Editor" Padding="12,9" Click="OnCataloguePlace" IsEnabled="False"/>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Button x:Name="CatOpenMapButton" Content="Open map" Padding="12,8" Click="OnCatalogueOpenMap" IsEnabled="False"/>
                  <Button x:Name="CatFavButton" Grid.Column="2" Content="Add to favourites" Padding="12,8" Click="OnToggleFavorite" IsEnabled="False"/>
                </Grid>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CatalogueDetails"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5" Margin="-2,0" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" Panel.ZIndex="5"/>

      <!-- ============================================== outliner + inspector -->
      <Grid x:Name="ScenePanel" Grid.Column="4" Background="{StaticResource Bg1}">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="OutlinerRow" Height="2*" MinHeight="120"/>
          <RowDefinition Height="1"/>
          <RowDefinition x:Name="InspectorRow" Height="3*" MinHeight="160"/>
        </Grid.RowDefinitions>
        <DockPanel x:Name="OutlinerPanel">
          <Grid DockPanel.Dock="Top" Margin="14,14,14,8">
            <TextBlock Text="SCENE HIERARCHY" Style="{StaticResource MicroAccent}"/>
            <TextBlock x:Name="OutlinerCount" HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" FontSize="10.5" Foreground="{StaticResource Text3}"/>
          </Grid>
          <TreeView x:Name="Hierarchy" Margin="4,0,4,6" SelectedItemChanged="OnHierarchySelected"/>
        </DockPanel>
        <GridSplitter x:Name="ScenePanelSplitter" Grid.Row="1" Height="5" Margin="0,-2" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterDragCompleted" Panel.ZIndex="5"/>
        <DockPanel x:Name="InspectorPanel" Grid.Row="2">
          <Grid DockPanel.Dock="Top" Margin="14,14,14,4">
            <TextBlock Text="INSPECTOR" Style="{StaticResource MicroAccent}"/>
          </Grid>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PropertiesPanel" Margin="14,0,14,16"/>
          </ScrollViewer>
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
