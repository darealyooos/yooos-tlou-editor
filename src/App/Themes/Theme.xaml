<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Yooos TLOU Editor design system.
    Palette: near-black charcoal, olive / concrete greys, warm paper text, a single restrained amber accent.
    Rules: square corners (1px max radius), 1px hairlines, no drop shadows on panels, uppercase micro-labels
    in Bahnschrift, body text in Segoe UI. Everything else in the app references these keys.
  -->

  <!-- ============================================================ tokens -->
  <Color x:Key="C.Bg0">#0B0C0B</Color>
  <Color x:Key="C.Bg1">#111311</Color>
  <Color x:Key="C.Bg2">#161916</Color>
  <Color x:Key="C.Bg3">#1C201C</Color>
  <Color x:Key="C.Hover">#21261F</Color>
  <Color x:Key="C.Input">#0D0F0D</Color>
  <Color x:Key="C.Line">#222622</Color>
  <Color x:Key="C.Line2">#2E342D</Color>
  <Color x:Key="C.Line3">#424A3F</Color>
  <Color x:Key="C.Text">#E6E0D2</Color>
  <Color x:Key="C.Text2">#B3AD9E</Color>
  <Color x:Key="C.Text3">#7E7D73</Color>
  <Color x:Key="C.Text4">#5A5B53</Color>
  <Color x:Key="C.Olive">#7A8461</Color>
  <Color x:Key="C.OliveDeep">#262B21</Color>
  <Color x:Key="C.Amber">#C9974F</Color>
  <Color x:Key="C.AmberHi">#E0B472</Color>
  <Color x:Key="C.AmberLo">#7D5F35</Color>
  <Color x:Key="C.AmberWash">#2BC9974F</Color>
  <Color x:Key="C.Danger">#C0583F</Color>

  <SolidColorBrush x:Key="Bg0" Color="{StaticResource C.Bg0}"/>
  <SolidColorBrush x:Key="Bg1" Color="{StaticResource C.Bg1}"/>
  <SolidColorBrush x:Key="Bg2" Color="{StaticResource C.Bg2}"/>
  <SolidColorBrush x:Key="Bg3" Color="{StaticResource C.Bg3}"/>
  <SolidColorBrush x:Key="Hover" Color="{StaticResource C.Hover}"/>
  <SolidColorBrush x:Key="Input" Color="{StaticResource C.Input}"/>
  <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
  <SolidColorBrush x:Key="Line2" Color="{StaticResource C.Line2}"/>
  <SolidColorBrush x:Key="Line3" Color="{StaticResource C.Line3}"/>
  <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
  <SolidColorBrush x:Key="Text2" Color="{StaticResource C.Text2}"/>
  <SolidColorBrush x:Key="Text3" Color="{StaticResource C.Text3}"/>
  <SolidColorBrush x:Key="Text4" Color="{StaticResource C.Text4}"/>
  <SolidColorBrush x:Key="Olive" Color="{StaticResource C.Olive}"/>
  <SolidColorBrush x:Key="OliveDeep" Color="{StaticResource C.OliveDeep}"/>
  <SolidColorBrush x:Key="Amber" Color="{StaticResource C.Amber}"/>
  <SolidColorBrush x:Key="AmberHi" Color="{StaticResource C.AmberHi}"/>
  <SolidColorBrush x:Key="AmberLo" Color="{StaticResource C.AmberLo}"/>
  <SolidColorBrush x:Key="AmberWash" Color="{StaticResource C.AmberWash}"/>
  <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}"/>
  <SolidColorBrush x:Key="AxisX" Color="#C2624F"/>
  <SolidColorBrush x:Key="AxisY" Color="#8DA35E"/>
  <SolidColorBrush x:Key="AxisZ" Color="#5E86B0"/>

  <FontFamily x:Key="Display">Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Duration x:Key="Fast">0:0:0.12</Duration>

  <!-- Density-driven sizes (replaced at runtime by Settings > Appearance / Asset Catalogue). -->
  <sys:Double x:Key="RowHeight">34</sys:Double>
  <sys:Double x:Key="TileImageHeight">86</sys:Double>

  <!-- Atmospheric viewport backdrop: dusk haze over near-black ground. -->
  <LinearGradientBrush x:Key="ViewportSky" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1B201C" Offset="0"/>
    <GradientStop Color="#141815" Offset="0.45"/>
    <GradientStop Color="#0C0E0C" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="Vignette" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.75" RadiusY="0.8">
    <GradientStop Color="#00000000" Offset="0.55"/>
    <GradientStop Color="#8C050605" Offset="1"/>
  </RadialGradientBrush>

  <!-- ============================================================ text -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
  </Style>
  <!-- Uppercase micro label used for section and field captions. -->
  <Style x:Key="Micro" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="MicroAccent" TargetType="TextBlock" BasedOn="{StaticResource Micro}">
    <Setter Property="Foreground" Value="{StaticResource Amber}"/>
  </Style>
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="Dim" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- ============================================================ focus -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Stroke="{StaticResource AmberLo}" StrokeThickness="1" Margin="-1" SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ buttons -->
  <!-- Default: quiet outlined button. -->
  <Style TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line3}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg0}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary: the one amber call to action per area. -->
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource Amber}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Amber}"/>
    <Setter Property="Foreground" Value="#14120E"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AmberHi}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AmberHi}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AmberLo}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line2}"/>
              <Setter Property="Foreground" Value="{StaticResource Text4}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Ghost: borderless text/icon button for toolbars and the navigation bar. -->
  <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg0}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Navigation dropdown trigger (Viewport / Tools / Settings / Scene). -->
  <Style x:Key="NavMenu" TargetType="Button" BasedOn="{StaticResource Ghost}">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource Display}" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="8" Margin="7,2,0,0" Foreground="{StaticResource Text4}"/>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Workspace tab in the navigation bar: amber underline when active. -->
  <Style x:Key="NavTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Height="40">
            <ContentPresenter Margin="12,0" VerticalAlignment="Center"/>
            <Rectangle x:Name="bar" Height="2" VerticalAlignment="Bottom" Margin="12,0" Fill="{StaticResource Amber}" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Trigger.EnterActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Fast}"/></Storyboard></BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Fast}"/></Storyboard></BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented choice (source selector, list/grid). -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="0,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0,0,0,1">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg3}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Category chip. -->
  <Style x:Key="Chip" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,4,4"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" BorderBrush="{StaticResource Line2}" BorderThickness="1" Padding="8,3">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line3}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AmberHi}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AmberLo}"/>
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AmberWash}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Viewport tool toggle (Move / Rotate / Scale / Boundary) and toggle chips. -->
  <Style x:Key="Tool" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Amber}"/>
              <Setter Property="Foreground" Value="#14120E"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource Tool}">
    <Setter Property="Padding" Value="7,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Amber}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- On/off switch used in Settings and overlay chips. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Border x:Name="track" Grid.Column="1" Width="28" Height="14" BorderBrush="{StaticResource Line3}" BorderThickness="1" Background="{StaticResource Input}">
              <Rectangle x:Name="knob" Width="8" Height="8" Fill="{StaticResource Text3}" HorizontalAlignment="Left" Margin="2,0"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="knob" Property="Fill" Value="#14120E"/>
              <Setter TargetName="track" Property="Background" Value="{StaticResource Amber}"/>
              <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Amber}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ inputs -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Input}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CaretBrush" Value="{StaticResource AmberHi}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Amber}"/>
    <Setter Property="SelectionOpacity" Value="0.35"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line3}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}"/>
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="bd" Property="Background" Value="Transparent"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Slim scrollbars: a 6px thumb, no arrows. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="t" Background="{StaticResource Line3}" Opacity="0.7"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Opacity" Value="1"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource AmberLo}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="1,2">
            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="MinHeight" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,1">
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ComboBox: flat field + dark popup list. -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="{StaticResource Input}" BorderBrush="{StaticResource Line2}" BorderThickness="1">
            <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="8" HorizontalAlignment="Right" Margin="0,0,8,0" Foreground="{StaticResource Text3}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Line3}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Amber}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
            <ContentPresenter IsHitTestVisible="False" Margin="7,0,24,0" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line3}" BorderThickness="1" Margin="0,2,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="8,5">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AmberHi}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource Amber}"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="16" Background="Transparent">
            <Rectangle Height="1" Fill="{StaticResource Line3}" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Rectangle Height="1" Fill="{StaticResource Amber}" VerticalAlignment="Center"/></Grid></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Rectangle x:Name="k" Width="6" Height="12" Fill="{StaticResource Text}"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="k" Property="Fill" Value="{StaticResource AmberHi}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ lists -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent">
            <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <Rectangle x:Name="mark" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Amber}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Bg2}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource AmberWash}"/>
              <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Outliner tree. -->
  <Style x:Key="ExpanderToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <TextBlock x:Name="g" Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="8" Foreground="{StaticResource Text4}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="g" Property="Text" Value="&#xE70D;"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Foreground" Value="{StaticResource Text}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TreeView">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <StackPanel>
            <Grid x:Name="row" Background="Transparent" MinHeight="24">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Rectangle x:Name="mark" Grid.ColumnSpan="2" Width="2" HorizontalAlignment="Left" Fill="{StaticResource Amber}" Visibility="Collapsed"/>
              <ToggleButton x:Name="exp" Style="{StaticResource ExpanderToggle}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="2,0,8,0"/>
            </Grid>
            <ItemsPresenter x:Name="kids" Margin="12,0,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False"><Setter TargetName="exp" Property="Visibility" Value="Hidden"/></Trigger>
            <Trigger Property="IsExpanded" Value="False"><Setter TargetName="kids" Property="Visibility" Value="Collapsed"/></Trigger>
            <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{StaticResource Bg2}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="row" Property="Background" Value="{StaticResource AmberWash}"/>
              <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================ menus -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line3}" BorderThickness="1" Padding="0,5" MinWidth="250">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Text2}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" Padding="0,6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="check" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="10" Foreground="{StaticResource Amber}" Visibility="Hidden"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontFamily="{StaticResource Display}" FontSize="11" Foreground="{StaticResource Text4}" Margin="24,0,14,0" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="check" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Fill="{StaticResource Line2}" Margin="0,5"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Separators inside menus resolve this key, not the implicit Separator style. -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Rectangle Height="1" Fill="{StaticResource Line2}" Margin="0,5"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Non-interactive heading inside a menu. -->
  <Style x:Key="MenuHeading" TargetType="MenuItem">
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <TextBlock Text="{TemplateBinding Header}" Style="{StaticResource Micro}" Margin="28,6,14,3"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource Bg3}" BorderBrush="{StaticResource Line3}" BorderThickness="1" Padding="8,5" MaxWidth="360">
            <ContentPresenter TextBlock.FontSize="11.5"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="{StaticResource Line}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Grid Background="Transparent">
            <Rectangle x:Name="r" Fill="{TemplateBinding Background}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="r" Property="Fill" Value="{StaticResource AmberLo}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="r" Property="Fill" Value="{StaticResource Amber}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Keyboard key cap used in hints and the shortcut sheet. -->
  <Style x:Key="KeyCap" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Line3}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="5,1"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Floating overlay surface inside the viewport. -->
  <Style x:Key="Overlay" TargetType="Border">
    <Setter Property="Background" Value="#D9111311"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
</ResourceDictionary>
