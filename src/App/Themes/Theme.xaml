<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!--
    Yooos TLOU Editor design system (v2, "studio").
    Palette: cool graphite surfaces, neutral text, one discreet violet-blue accent used for selection, focus and
    the active tool. Rules: 3px corner radius at most, 1px hairlines, no glass or drop shadows on panels,
    Segoe UI everywhere (Cascadia Mono for numbers), 16px stroke icons from the I.* geometries below.
    Everything else in the app references these keys.
  -->

  <!-- ============================================================ tokens -->
  <Color x:Key="C.Bg0">#111318</Color>          <!-- app background, viewport surround -->
  <Color x:Key="C.Bg1">#191C23</Color>          <!-- panels -->
  <Color x:Key="C.Bg2">#20242D</Color>          <!-- secondary panels, headers -->
  <Color x:Key="C.Bg3">#272C36</Color>          <!-- raised: cards, pressed tools -->
  <Color x:Key="C.Hover">#2B303B</Color>
  <Color x:Key="C.Input">#14161C</Color>
  <Color x:Key="C.Line">#303541</Color>
  <Color x:Key="C.Line2">#3A404D</Color>
  <Color x:Key="C.Line3">#4D5464</Color>
  <Color x:Key="C.Text">#E5E7EB</Color>
  <Color x:Key="C.Text2">#BCC1CA</Color>
  <Color x:Key="C.Text3">#9299A6</Color>
  <Color x:Key="C.Text4">#656C7A</Color>
  <Color x:Key="C.Accent">#7778E8</Color>
  <Color x:Key="C.AccentHi">#9798F2</Color>
  <Color x:Key="C.AccentLo">#4E4FB0</Color>
  <Color x:Key="C.AccentWash">#337778E8</Color>
  <Color x:Key="C.AccentSoft">#1A7778E8</Color>
  <Color x:Key="C.Success">#5BAE84</Color>
  <Color x:Key="C.Warning">#D6A54A</Color>
  <Color x:Key="C.Danger">#E0705C</Color>
  <Color x:Key="C.Star">#E2B84E</Color>

  <SolidColorBrush x:Key="Bg0" Color="{StaticResource C.Bg0}"/>
  <SolidColorBrush x:Key="Bg1" Color="{StaticResource C.Bg1}"/>
  <SolidColorBrush x:Key="Bg2" Color="{StaticResource C.Bg2}"/>
  <SolidColorBrush x:Key="Bg3" Color="{StaticResource C.Bg3}"/>
  <SolidColorBrush x:Key="Hover" Color="{StaticResource C.Hover}"/>
  <SolidColorBrush x:Key="Input" Color="{StaticResource C.Input}"/>
  <SolidColorBrush x:Key="Line" Color="{StaticResource C.Line}"/>
  <SolidColorBrush x:Key="Line2" Color="{StaticResource C.Line2}"/>
  <SolidColorBrush x:Key="Line3" Color="{StaticResource C.Line3}"/>
  <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}"/>
  <SolidColorBrush x:Key="Text2" Color="{StaticResource C.Text2}"/>
  <SolidColorBrush x:Key="Text3" Color="{StaticResource C.Text3}"/>
  <SolidColorBrush x:Key="Text4" Color="{StaticResource C.Text4}"/>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}"/>
  <SolidColorBrush x:Key="AccentHi" Color="{StaticResource C.AccentHi}"/>
  <SolidColorBrush x:Key="AccentLo" Color="{StaticResource C.AccentLo}"/>
  <SolidColorBrush x:Key="AccentWash" Color="{StaticResource C.AccentWash}"/>
  <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource C.AccentSoft}"/>
  <SolidColorBrush x:Key="Success" Color="{StaticResource C.Success}"/>
  <SolidColorBrush x:Key="Warning" Color="{StaticResource C.Warning}"/>
  <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}"/>
  <SolidColorBrush x:Key="Star" Color="{StaticResource C.Star}"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AxisX" Color="#E5625A"/>
  <SolidColorBrush x:Key="AxisY" Color="#79C35A"/>
  <SolidColorBrush x:Key="AxisZ" Color="#5A94F0"/>
  <SolidColorBrush x:Key="TeamWlf" Color="#5C8DB8"/>
  <SolidColorBrush x:Key="TeamScar" Color="#C0624A"/>

  <FontFamily x:Key="Display">Segoe UI</FontFamily>
  <FontFamily x:Key="Body">Segoe UI</FontFamily>
  <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <Duration x:Key="Fast">0:0:0.12</Duration>
  <CornerRadius x:Key="Radius">3</CornerRadius>

  <!-- Density-driven sizes (replaced at runtime by Settings > Appearance / Asset Catalogue). -->
  <sys:Double x:Key="RowHeight">34</sys:Double>
  <sys:Double x:Key="TileImageHeight">86</sys:Double>

  <!-- Viewport backdrop: a quiet graphite horizon. -->
  <LinearGradientBrush x:Key="ViewportSky" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#232731" Offset="0"/>
    <GradientStop Color="#1A1D24" Offset="0.5"/>
    <GradientStop Color="#121419" Offset="1"/>
  </LinearGradientBrush>
  <RadialGradientBrush x:Key="Vignette" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.8" RadiusY="0.85">
    <GradientStop Color="#00000000" Offset="0.6"/>
    <GradientStop Color="#40080A0E" Offset="1"/>
  </RadialGradientBrush>

